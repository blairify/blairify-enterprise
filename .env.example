# Database Configuration for Neon Postgres
# Connection pooling URL (use for serverless/edge functions)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection URL (use for migrations and Prisma Studio)
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

MISTRAL_API_KEY="your_mistral_api_key_here"

# Add other environment variables here
